#!/usr/bin/env bash
# The gate. CI runs this script (bin/repo-guards fails when it stops), so green here is green there.
#
#   bin/check                 full gate: repo guards, FULL_STEPS, docs, workflow lint, audit and visual tests
#   bin/check fast            inner loop: repo guards + the FAST_STEPS subset (no demo, no typecheck)
#   bin/check files <path>…   only the named files: stylelint on .scss, eslint on .ts/.tsx,
#                             prettier on all of them, vitest on the tests related to them
#
# Full also requires a running Docker daemon and network access (images and npm audit).
# Exit: 0 green · 75 environment missing (nothing was graded) · 1 a check failed.
# Every failure prints the failing command and the command to rerun just that step.
#
# `fast` blind spots: the demo (its lint, types and build), formatting, the icon validation, the
# bundle-size budget, package contents, docs truth, workflow lint, audit and visual tests.
# `files` also skips the repo guards and the Sass build of files no test compiles.
# Agents sharing this checkout run `bin/check files <their paths>` only.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=_dx.sh
source "$(dirname "${BASH_SOURCE[0]}")/_dx.sh"
cd "$ROOT" || exit 1

# The npm scripts each tier runs, in order. FAST_STEPS must be a subset of FULL_STEPS.
FULL_STEPS=(lint format:check typecheck test validate:icons build check:size check:package)
FAST_STEPS=(lint:css test)

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

mode="${1:-full}"
case "$mode" in
  full | fast) [ "$#" -le 1 ] || { usage >&2; exit 2; } ;;
  files) shift; [ "$#" -ge 1 ] || { usage >&2; exit 2; } ;;
  -h | --help)
    usage
    printf '\nfull: %s\nfast: %s\n' "${FULL_STEPS[*]}" "${FAST_STEPS[*]}"
    exit 0
    ;;
  *) usage >&2; exit 2 ;;
esac

failed=()

# run_step <name> <command…> — runs the command, records a failure, keeps going.
run_step() {
  local name="$1" status
  shift
  step "$name: $*"
  "$@"
  status=$?
  if [ "$status" -eq 0 ]; then
    ok "$name"
  else
    printf '  ✗ %s (exit %s)\n' "$name" "$status"
    failed+=("$name|$*")
  fi
  return "$status"
}

use_node require
require_deps
if [ "$mode" = full ]; then
  command -v docker >/dev/null 2>&1 || env_missing "docker is required for workflow and visual tests" "install Docker and start its daemon"
  docker info >/dev/null 2>&1 || env_missing "Docker daemon is unavailable" "start Docker and ensure it is accessible"
fi

case "$mode" in
  full)
    run_step guards bin/repo-guards
    build_ok=false
    for script in "${FULL_STEPS[@]}"; do
      if run_step "$script" npm run --silent "$script"; then
        [ "$script" != build ] || build_ok=true
      fi
    done
    run_step docs bin/docs-check
    run_step actionlint docker run --rm -v "$PWD:/repo" -w /repo rhysd/actionlint:1.7.12 -color
    run_step zizmor docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD:/repo:ro" -w /repo ghcr.io/zizmorcore/zizmor:1.33.1@sha256:ecd3ffe6158de1322e05a044ed43749bee12b1dccb7e1a7859bc6ac4b2a1c516 --format=github .github/workflows
    run_step audit npm audit --audit-level=low
    if [ "$build_ok" = true ]; then
      run_step visual npm run --silent test:visual
    else
      printf '  visual: not run because the build failed\n'
    fi
    ;;
  fast)
    run_step guards bin/repo-guards
    for script in "${FAST_STEPS[@]}"; do run_step "$script" npm run --silent "$script"; done
    ;;
  files)
    scss=() js=() all=()
    for path in "$@"; do
      [ -e "$path" ] || { echo "bin/check files: no such file: $path" >&2; exit 2; }
      case "$path" in
        *.scss) scss+=("$path"); all+=("$path") ;;
        *.ts | *.tsx | *.js | *.mjs) js+=("$path"); all+=("$path") ;;
        *.json | *.md | *.yml | *.yaml | *.css | *.html) all+=("$path") ;;
      esac
    done
    if [ "${#scss[@]}" -gt 0 ]; then run_step lint:css npx --no-install stylelint "${scss[@]}"; fi
    if [ "${#js[@]}" -gt 0 ]; then run_step lint:js npx --no-install eslint "${js[@]}"; fi
    if [ "${#all[@]}" -gt 0 ]; then
      run_step format:check npx --no-install prettier --check --ignore-unknown "${all[@]}"
    fi
    # `vitest related` runs the tests whose import graph reaches the named files. The CSS tests
    # compile src/scss/ through Sass, not through imports, so a named .scss runs the whole suite.
    if [ "${#scss[@]}" -gt 0 ]; then
      run_step test npx --no-install vitest run
    else
      run_step test npx --no-install vitest related --run --passWithNoTests "$@"
    fi
    ;;
esac

if [ "${#failed[@]}" -eq 0 ]; then
  printf '\nbin/check %s: GREEN\n' "$mode"
  exit 0
fi

printf '\nbin/check %s: FAILED (%s step(s))\n' "$mode" "${#failed[@]}"
for entry in "${failed[@]}"; do
  name="${entry%%|*}"
  command="${entry#*|}"
  case "$name" in
    test) rerun='npx vitest run <tests/file.test.ts>   (one file; -t "<name>" for one test)' ;;
    *) rerun="$command" ;;
  esac
  printf '  ✗ %s\n      failing command: %s\n      rerun:           %s\n' "$name" "$command" "$rerun"
done
printf '  autofix: "npm run lint:fix" (stylelint, eslint) and "npm run format" (prettier).\n'
exit 1
