#!/usr/bin/env bash
# The demo site (Vite) with hot reload. It imports src/scss/ directly, so an SCSS edit shows at once.
#
#   bin/dev            foreground, Ctrl-C to stop
#   bin/dev --detach   background; returns once the site answers, stop it with bin/stop
#
#   Site: http://127.0.0.1:5173/cybercore-css/   (PORT=<n> picks another port; the port is strict,
#                                                 a taken one is an error, never a silent move)
#   Routes are real paths: /cybercore-css/components, /effects, /utilities, /icons, /docs
#   Logs (detached): tmp/dx/dev.log
#
# Exit 75 = environment missing (Node, node_modules) — run bin/setup.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_dx.sh
source "$(dirname "${BASH_SOURCE[0]}")/_dx.sh"
cd "$ROOT" || exit 1

detach=false
case "${1:-}" in
  "") ;;
  -d | --detach) detach=true ;;
  -h | --help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "usage: bin/dev [--detach]" >&2; exit 2 ;;
esac

port="${PORT:-5173}"
url="http://127.0.0.1:${port}/cybercore-css/"

if [ -f "$DEV_PID_FILE" ] && kill -0 "$(cat "$DEV_PID_FILE")" 2>/dev/null; then
  echo "bin/dev is already running (pid $(cat "$DEV_PID_FILE")). Stop it with bin/stop."
  exit 0
fi

use_node require
require_deps

vite=(npx --no-install vite --config demo/vite.config.ts --host 127.0.0.1 --port "$port" --strictPort)

if [ "$detach" = false ]; then
  exec "${vite[@]}"
fi

mkdir -p "$DX_STATE_DIR"
# setsid: its own process group, so bin/stop can end npx and the vite it spawned together.
setsid "${vite[@]}" >"$DEV_LOG_FILE" 2>&1 &
echo "$!" >"$DEV_PID_FILE"

waited=0
until curl --silent --fail --output /dev/null "$url"; do
  waited=$((waited + 1))
  if ! kill -0 "$(cat "$DEV_PID_FILE")" 2>/dev/null || [ "$waited" -ge 30 ]; then
    echo "The dev server did not answer on $url within 30s. Last log lines:" >&2
    tail -n 30 "$DEV_LOG_FILE" >&2
    kill -- "-$(cat "$DEV_PID_FILE")" 2>/dev/null || true
    rm -f "$DEV_PID_FILE"
    exit 1
  fi
  sleep 1
done
ok "up at $url (pid $(cat "$DEV_PID_FILE"), log $DEV_LOG_FILE) — stop it with bin/stop"
